#!/command/with-contenv bashio
# shellcheck shell=bash
set -eo pipefail

LIB=/usr/lib/hetrixtools
RUN_DIR=/run/hetrixtools

# --- validate SID (fail fast, clear message) ---
SID="$(bashio::config 'sid')"
if [[ ! "$SID" =~ ^[A-Za-z0-9]{32}$ ]]; then
	bashio::exit.nok "Invalid or missing 'sid' (need a 32-char HetrixTools Server ID)."
fi

# --- render cfg next to a working copy of the agent ---
mkdir -p "$RUN_DIR"
cp "$LIB/hetrixtools_agent.sh" "$RUN_DIR/hetrixtools_agent.sh"

export SID
export COLLECT_EVERY_SECONDS; COLLECT_EVERY_SECONDS="$(bashio::config 'collect_every_seconds')"
export CHECK_DRIVE_HEALTH;    CHECK_DRIVE_HEALTH="$(bashio::config 'check_drive_health' | grep -q true && echo 1 || echo 0)"
export CHECK_SOFT_RAID;       CHECK_SOFT_RAID="$(bashio::config 'check_soft_raid' | grep -q true && echo 1 || echo 0)"
export CHECK_REBOOT;          CHECK_REBOOT="$(bashio::config 'check_reboot' | grep -q true && echo 1 || echo 0)"
export RUNNING_PROCESSES;     RUNNING_PROCESSES="$(bashio::config 'running_processes' | grep -q true && echo 1 || echo 0)"
export CONNECTION_PORTS;      CONNECTION_PORTS="$(bashio::config 'connection_ports' | tr '\n' ',' | sed 's/,$//')"
export CHECK_SERVICES;        CHECK_SERVICES="$(bashio::config 'check_services' | tr '\n' ',' | sed 's/,$//')"
# Empty means "use the renderer's default", which excludes the container's own
# overlay root as well as the filesystem types upstream already skips.
export IGNORED_DISKS;         IGNORED_DISKS="$(bashio::config 'ignored_disks')"
export DEBUG_MODE;            DEBUG_MODE="$(bashio::config 'debug' | grep -q true && echo 1 || echo 0)"
# The agent separates ping targets with '|', not ','; each entry is
# name,host[,port] and may legitimately contain commas, so only the entry
# separator is substituted here.
export OUTGOING_PINGS;        OUTGOING_PINGS="$(bashio::config 'outgoing_pings' | tr '\n' '|' | sed 's/|$//')"
export OUTGOING_PINGS_COUNT;  OUTGOING_PINGS_COUNT="$(bashio::config 'outgoing_pings_count')"

# Pin the agent to real host NICs. Left unset, the agent auto-detects once per
# invocation and sweeps up Docker's ephemeral veth* interfaces, which vanish
# mid-sample and turn the log into awk syntax errors. If detection yields
# nothing we pass an empty value, which the agent reads as "auto-detect" -- the
# same behaviour as before, so a host we fail to classify is never left unmonitored.
export NETWORK_INTERFACES
NETWORK_INTERFACES="$(ip a 2>/dev/null | bash "$LIB/detect-interfaces.sh" || true)"
if [ -n "$NETWORK_INTERFACES" ]; then
	bashio::log.info "Monitoring network interfaces: ${NETWORK_INTERFACES}"
else
	bashio::log.warning "No host network interfaces detected; falling back to agent auto-detection."
fi

bash "$LIB/render-config.sh" "$RUN_DIR/hetrixtools.cfg"

if bashio::config.true 'debug'; then
	bashio::log.info "debug enabled: agent diagnostics will be echoed after each cycle."
fi

if bashio::config.true 'dry_run'; then
	export DryRun=1
	bashio::log.warning "dry_run enabled: payloads printed, not sent."
fi

bashio::log.info "Starting HetrixTools agent loop (SID ${SID:0:6}…)."

# --- agent loop ---
# The agent self-paces each invocation to ~60s (it samples for a minute, then
# POSTs once). collect_every_seconds changes sample granularity, NOT the POST
# interval. The sleep below is only a crash-loop backstop: if a cycle exits
# early, backfill the rest of the minute so a broken agent can't hammer the API.
while true; do
	start=$(date +%s)
	bash "$RUN_DIR/hetrixtools_agent.sh" || bashio::log.warning "agent cycle exited non-zero"
	# The agent writes diagnostics to a file beside itself, on tmpfs, where the
	# Log tab never sees them. Surface each cycle's worth and truncate, so the
	# log cannot grow without bound across a long-running debug session.
	if [ -s "$RUN_DIR/debug.log" ]; then
		cat "$RUN_DIR/debug.log"
		: > "$RUN_DIR/debug.log"
	fi
	elapsed=$(( $(date +%s) - start ))
	# Guard against a backward clock step (NTP) yielding a negative duration.
	if [ "$elapsed" -lt 0 ]; then
		elapsed=0
	fi
	if [ "$elapsed" -lt 55 ]; then
		sleep $(( 60 - elapsed ))
	fi
done
